# ─── SAL HUB — variáveis de ambiente ──────────────────────────────────────────
# Copie este arquivo para .env.local e preencha os valores.
#   Windows PowerShell:  Copy-Item env.example .env.local
#   bash:                cp env.example .env.local
# .env.local NUNCA é commitado (ver .gitignore).

# URL do projeto Supabase (público)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável / anon do Supabase (público — o acesso é protegido por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service role key do Supabase — SOMENTE SERVIDOR.
# Usada apenas pelas Server Actions de administração (criar usuário) e pelo
# script scripts/promote-admin.mjs. Nunca expor no browser, nunca prefixar com
# NEXT_PUBLIC_, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# URL base da aplicação, usada no link de recuperação de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
