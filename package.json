{
  "name": "sal-hub",
  "version": "1.0.0",
  "private": true,
  "description": "SAL HUB — Portal de Sistemas e Indicadores da SAL Express",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "promote-admin": "node scripts/promote-admin.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "auth:check": "node scripts/check-auth-config.mjs",
    "auth:push": "node scripts/check-auth-config.mjs && supabase config push"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
